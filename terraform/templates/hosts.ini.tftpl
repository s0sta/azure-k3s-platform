# Written by Terraform. Do not edit by hand.
[k3s_server]
server ansible_host=${server_public} private_ip=${server_private}

[k3s_agent]
%{ for i, ip in agents ~}
agent-${i + 1} ansible_host=${ip} private_ip=${ip} ansible_ssh_common_args='-o ProxyJump=${admin_username}@${server_public}'
%{ endfor ~}

[k3s:children]
k3s_server
k3s_agent

[k3s:vars]
ansible_user=${admin_username}
ingress_public_ip=${ingress_ip}
key_vault_name=${key_vault}
